# =====================
# Gopayment Vercel - Env
# Copy file ini jadi .env lalu isi nilainya.
# JANGAN pernah commit .env ke git.
# =====================

# Kredensial akun merchant GoBiz (GoFood Merchant)
# Dipakai untuk login ke API GoBiz dan cek status pembayaran.
GOPAY_EMAIL=email_merchant_contoh@example.com
GOPAY_PASSWORD=ganti_dengan_password_merchant

# String QRIS statis dari akun merchant kamu.
# Cara dapat: scan gambar QRIS di portal.gofoodmerchant.co.id pakai
# scanner yang menampilkan raw text (contoh zxing.org), lalu copy
# string panjang yang diawali 000201...
QRIS_STRING=ganti_dengan_string_qris_statis

# Upstash Redis (wajib untuk session tersimpan lintas request).
# Daftar gratis di https://upstash.com, buat database, copy URL REST + token.
UPSTASH_REDIS_REST_URL=https://contoh.upstash.io
UPSTASH_REDIS_REST_TOKEN=ganti_dengan_token_upstash

# URL deployment Vercel kamu.
# Contoh: https://gopayment-vercel.vercel.app
APP_URL=https://gopayment-vercel.vercel.app

# Discord webhook (opsional).
# Dikirim saat pembayaran berhasil dikonfirmasi.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Discord webhook untuk log request (opsional).
# Mirip log dashboard Vercel, tapi dikirim ke Discord.
DEBUG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# API key untuk endpoint gateway (/api/gateway).
# Wajib diisi kalau mau integrasi dari aplikasi lain.
# Buat string acak panjang, contoh: openssl rand -hex 32
GATEWAY_API_KEY=ganti_dengan_api_key_acak_panjang